// The web page of the desk, served by Cloudflare as a Worker of static
// assets alone, without a script. scripts/deploy.sh builds it into
// site/dist and deploys it.
{
  "name": "mygo-platinum",
  "compatibility_date": "2026-10-16",
  "assets": { "directory": "./site/dist" },
  "routes": [{ "pattern": "mygo-platinum.firede.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
